    "baseline-browser-mapping": "^2.8.32",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "^10.1.7",
    "eslint-plugin-tailwindcss": "^4.0.0-beta.0",
    "graphql": "^16.12.0",
    "playwright": "^1.57.0",
    "prettier": "^3.6.2",
