    "lodash-es": "^4.17.21",
    "motion": "^12.23.24",
    "next": "^16.0.10",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
