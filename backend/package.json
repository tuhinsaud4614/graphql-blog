{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "start": "set NODE_ENV=production && node dist/index.js",
    "dev": "set NODE_ENV=development && npm run db:gen && npm run db:mig && npm run db:seed && tsx watch ./src/app.ts",
    "build": "rimraf ./dist && tsup",
    "db:gen": "npx prisma generate",
    "db:mig": "npx prisma migrate dev --name init",
    "db:pull": "npx prisma db pull",
    "db:seed": "npx prisma db seed",
    "db:studio": "npx prisma studio",
    "lint": "npx eslint .",
    "lint:fix": "npx eslint . --fix"
  },
  "tsup": {
    "entry": [
      "src/index.ts"
    ],
    "splitting": false,
    "sourcemap": true,
    "clean": true,
    "format": [
      "esm",
      "cjs"
    ],
    "minify": true
  },
  "prisma": {
    "seed": "node --env-file=.env --import=tsx prisma/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/compat": "^1.3.1",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.19",
    "@types/morgan": "^1.9.10",
    "@types/ms": "^2.1.0",
    "@types/node": "^24.0.7",
    "@types/nodemailer": "^6.4.17",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth2": "^0.1.10",
    "@types/passport-jwt": "^4.0.1",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.35.0",
    "eslint": "^9.30.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.1",
    "prettier": "^3.6.2",
    "prisma": "^6.10.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^9.0.2",
    "@envelop/graphql-jit": "^10.0.0",
    "@envelop/rate-limiter": "^8.0.0",
    "@envelop/response-cache": "^8.0.0",
    "@envelop/response-cache-redis": "^4.2.4",
    "@graphql-tools/load-files": "^7.0.1",
    "@graphql-tools/merge": "^9.0.24",
    "@graphql-tools/schema": "^10.0.23",
    "@graphql-tools/utils": "^10.8.6",
    "@graphql-yoga/redis-event-target": "^3.0.3",
    "@prisma/client": "^6.10.1",
    "@types/lodash-es": "^4.17.12",
    "argon2": "^0.43.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "editorjs-html": "^4.0.5",
    "env-schema": "^6.0.1",
    "express": "^5.1.0",
    "graphql": "^16.11.0",
    "graphql-yoga": "^5.13.5",
    "image-size": "^2.0.2",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "lodash-es": "^4.17.21",
    "morgan": "^1.10.0",
    "ms": "^2.1.3",
    "nodemailer": "^7.0.3",
    "passport": "^0.7.0",
    "passport-google-oauth2": "^0.2.0",
    "passport-jwt": "^4.0.1",
    "superjson": "^2.2.2",
    "uninstall": "^0.0.0",
    "winston": "^3.17.0",
    "yup": "^1.6.1"
  }
}
